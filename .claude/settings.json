{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(python3 scripts/icones.py:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npx vite:*)",
      "Bash(gzip -c:*)",
      "Bash(du -h:*)",
      "Bash(node scripts/verifie.mjs:*)",
      "Bash(python3 scripts/polices.py:*)",
      "Bash(python3 scripts/fleches.py:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Edit(design/**)",
      "Write(design/**)",
      "Read(plis-source/**)",
      "Bash(git add:*plis-source*)",
      "Bash(git commit:*plis-source*)",
      "Bash(git add -f:*)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Edit(public/plis/**)",
      "Edit(public/icones/**)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/garde-irreversible.sh",
            "timeout": 15,
            "statusMessage": "garde des irréversibles"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verifie.sh",
            "timeout": 15,
            "statusMessage": "relecture déterministe"
          }
        ]
      }
    ]
  }
}
